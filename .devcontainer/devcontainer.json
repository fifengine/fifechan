{
  "name": "Fife DevBox",
  //"image": "ghcr.io/jakoch/cpp-devbox:trixie-with-vulkansdk-latest",
  "image": "ghcr.io/jakoch/cpp-devbox:trixie-with-vulkansdk-20260426",
  "customizations": {
    "vscode": {
      "extensions": [
        // EditorConfig
        "EditorConfig.EditorConfig",
        // Git + Github
        "GitHub.vscode-pull-request-github",
        // C++
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cpptools-themes",
        // CMake
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        // Testing
        "matepek.vscode-catch2-test-adapter",
        "ms-vscode.test-adapter-converter",
        "hbenl.vscode-test-explorer"
      ]
    }
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "--env=DISPLAY=${localEnv:DISPLAY}"
  ],
  "postStartCommand": "chmod +x ./build-tools/setup-vcpkg.sh && ./build-tools/setup-vcpkg.sh"
}